{
  // Linux dev environment matching the local setup (Python 3.12, Java 17, uv, PySpark 4.2).
  // Works in GitHub Codespaces and in VS Code Dev Containers.
  "name": "network-usage-medallion",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "jdkDistro": "tem"
    }
  },
  "postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && ~/.local/bin/uv sync",
  "forwardPorts": [4040],
  "portsAttributes": {
    "4040": { "label": "Spark UI", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  }
}
